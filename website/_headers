# Cloudflare 정적 자산 응답 헤더. 한글이 들어간 텍스트 파일이 깨지지 않게 charset 명시
/llms.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

# 모든 페이지: 파일 형식 추측 금지, 다른 사이트로 전체 주소 안 보냄, 다른 사이트의 프레임 안에 넣기 금지
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# CSS·JS: HTML이 내용 해시(?v=)로 부르므로 바뀌면 주소도 바뀜 → 1년 캐시, 재검증 없음 (scripts/build-site.mjs assetHash)
/style.css
  Cache-Control: public, max-age=31536000, immutable
/demo.js
  Cache-Control: public, max-age=31536000, immutable

# 이미지·아이콘: 주소가 고정이라 하루만 캐시
/brand-mark.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
